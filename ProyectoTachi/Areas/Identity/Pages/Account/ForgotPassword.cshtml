@page
@model ForgotPasswordModel
@{
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="auth-header text-center">
    <img src="~/img/tachi-logo.png" class="auth-logo" alt="Tachi Distribuidora" />
    <div class="auth-subtitle">Recuperar contraseña</div>
    <hr class="auth-divider" />
</div>

<p class="text-muted small text-center mb-3">
    Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña.
</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
        <div class="input-group">
            <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
            <input asp-for="Input.Email" class="form-control" placeholder="correo@ejemplo.com" />
        </div>
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 auth-btn">
        <i class="fa-solid fa-paper-plane me-2"></i>Enviar enlace de recuperación
    </button>

    <div class="text-center mt-3 small">
        <a asp-page="./Login" class="auth-link">Volver al inicio de sesión</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
