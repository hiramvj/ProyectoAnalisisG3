@page
@model ResetPasswordModel
@{
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
    ViewData["Title"] = "Restablecer contraseña";
}

<div class="auth-header text-center">
    <img src="~/img/tachi-logo.png" class="auth-logo" alt="Tachi Distribuidora" />
    <div class="auth-subtitle">Restablecer contraseña</div>
    <hr class="auth-divider" />
</div>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <input asp-for="Input.Code" type="hidden" />

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
        <div class="input-group">
            <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
            <input asp-for="Input.Email" class="form-control" placeholder="correo@ejemplo.com" />
        </div>
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">Nueva contraseña</label>
        <div class="input-group">
            <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
            <input asp-for="Input.Password" class="form-control" placeholder="********" />
        </div>
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar contraseña</label>
        <div class="input-group">
            <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
            <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="********" />
        </div>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 auth-btn">
        <i class="fa-solid fa-key me-2"></i>Restablecer contraseña
    </button>

    <div class="text-center mt-3 small">
        <a asp-page="./Login" class="auth-link">Volver al inicio de sesión</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
