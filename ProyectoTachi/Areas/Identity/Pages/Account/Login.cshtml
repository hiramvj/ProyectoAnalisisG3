@page
@model LoginModel
@{
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-header text-center">
    <img src="~/img/tachi-logo.png" class="auth-logo" alt="Tachi Distribuidora" />
    <div class="auth-subtitle">Sistema de Gestión - Materiales y ferretería</div>
    <hr class="auth-divider" />
</div>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label">Usuario</label>
        <div class="input-group">
            <span class="input-group-text"><i class="fa-regular fa-user"></i></span>
            <input asp-for="Input.Email" class="form-control" placeholder="Ej: admin" />
        </div>
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">Contraseña</label>
        <div class="input-group">
            <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
            <input asp-for="Input.Password" class="form-control" placeholder="********" />
        </div>
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="form-check">
            <input class="form-check-input" asp-for="Input.RememberMe" />
            <label class="form-check-label" asp-for="Input.RememberMe">Recordarme</label>
        </div>
        <a asp-page="./ForgotPassword" class="auth-link">¿Olvidaste tu contraseña?</a>
    </div>

    <button type="submit" class="btn btn-primary w-100 auth-btn">
        <i class="fa-solid fa-right-to-bracket me-2"></i>Ingresar
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}