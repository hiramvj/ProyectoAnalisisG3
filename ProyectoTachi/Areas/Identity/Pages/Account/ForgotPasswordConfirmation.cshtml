@page
@model ForgotPasswordConfirmationModel
@{
    Layout = "/Views/Shared/_LayoutAuth.cshtml";
    ViewData["Title"] = "Correo enviado";
}

<div class="auth-header text-center">
    <img src="~/img/tachi-logo.png" class="auth-logo" alt="Tachi Distribuidora" />
    <div class="auth-subtitle">Correo enviado</div>
    <hr class="auth-divider" />
</div>

<div class="text-center">
    <div class="mb-3">
        <i class="fa-solid fa-envelope-circle-check text-success" style="font-size: 3rem;"></i>
    </div>
    <p class="text-muted small">
        Si el correo electrónico está registrado, recibirás un enlace para restablecer tu contraseña.
        Revisa tu bandeja de entrada y la carpeta de spam.
    </p>
</div>

<div class="text-center mt-3 small">
    <a asp-page="./Login" class="auth-link">Volver al inicio de sesión</a>
</div>
