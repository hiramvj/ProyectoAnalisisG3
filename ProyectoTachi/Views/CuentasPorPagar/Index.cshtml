@model IEnumerable<Abstracciones.Modelos.CuentaPorPagarDto>
@{
    ViewData["Title"] = "Cuentas por Pagar";
}

<div class="row align-items-center mb-4">
    <div class="col-sm-6">
        <h2 class="mb-0">Gestión de Cuentas por Pagar</h2>
        <p class="text-muted">Control de facturas y pagos a proveedores</p>
    </div>
    <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
        <a asp-action="CrearFactura" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus-circle me-1"></i> Nueva Cuenta
        </a>
    </div>
</div>

@if (TempData["ContabilidadExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["ContabilidadExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ContabilidadError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ContabilidadError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">No. Factura</th>
                        <th>Proveedor</th>
                        <th>Emisión</th>
                        <th>Vencimiento</th>
                        <th>Monto Original</th>
                        <th>Saldo Pendiente</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fas fa-file-invoice-dollar fa-3x mb-3 text-light"></i>
                                <h5>No hay cuentas registradas</h5>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var esVencida = item.Estado == "PENDIENTE" && item.FechaVencimiento < DateTime.Today;
                            var rowClass = esVencida ? "table-danger" : "";

                            <tr class="@rowClass">
                                <td class="ps-4 fw-bold">@item.NumeroFactura</td>
                                <td>@item.ProveedorNombre</td>
                                <td>@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @item.FechaVencimiento.ToString("dd/MM/yyyy")
                                    @if(esVencida) { <i class="fas fa-exclamation-triangle text-danger" title="Vencida"></i> }
                                </td>
                                <td>₡@item.MontoOriginal.ToString("N2")</td>
                                <td class="fw-bold text-primary">₡@item.SaldoPendiente.ToString("N2")</td>
                                <td>
                                    @if (item.Estado == "PAGADA")
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check me-1"></i>PAGADA</span>
                                    }
                                    else if (item.Estado == "PENDIENTE")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>PENDIENTE</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Estado</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Detalle" asp-route-id="@item.CuentaPorPagarId" class="btn btn-sm btn-outline-info" title="Ver Detalle">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (item.SaldoPendiente > 0)
                                        {
                                            <a asp-action="RegistrarPago" asp-route-id="@item.CuentaPorPagarId" class="btn btn-sm btn-outline-success" title="Registrar Pago">
                                                <i class="fas fa-money-bill-wave"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
