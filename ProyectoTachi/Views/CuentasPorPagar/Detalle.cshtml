@model Abstracciones.Modelos.CuentaPorPagarDto
@{
    ViewData["Title"] = "Detalle de Cuenta";
    var pagos = ViewData["Pagos"] as IEnumerable<Abstracciones.Modelos.PagoProveedorDto>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-file-invoice text-primary me-2"></i>Factura #@Model.NumeroFactura</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Volver</a>
</div>

@if (TempData["ContabilidadExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["ContabilidadExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ContabilidadInfo"] != null)
{
    <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-info-circle me-2"></i> @TempData["ContabilidadInfo"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <!-- Columna Resumen Cuenta -->
    <div class="col-md-5 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Resumen</h5>
                @if (Model.Estado == "PAGADA")
                {
                    <span class="badge bg-success fs-6"><i class="fas fa-check-double me-1"></i>PAGADA</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark fs-6"><i class="fas fa-clock me-1"></i>PENDIENTE</span>
                }
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted">Proveedor</dt>
                    <dd class="col-sm-7 fw-bold">@Model.ProveedorNombre</dd>

                    <dt class="col-sm-5 text-muted">Emisión</dt>
                    <dd class="col-sm-7">@Model.FechaEmision.ToString("dd MMMM yyyy")</dd>

                    <dt class="col-sm-5 text-muted">Vencimiento</dt>
                    <dd class="col-sm-7">
                        @Model.FechaVencimiento.ToString("dd MMMM yyyy")
                        @if (Model.Estado == "PENDIENTE" && Model.FechaVencimiento < DateTime.Today)
                        {
                            <span class="text-danger small ms-1"><i class="fas fa-exclamation-triangle"></i> Vencida</span>
                        }
                    </dd>

                    <hr class="my-3"/>

                    <dt class="col-sm-5 text-muted">Monto Original</dt>
                    <dd class="col-sm-7">₡@Model.MontoOriginal.ToString("N2")</dd>

                    <dt class="col-sm-5 text-muted fs-5">Saldo Pendiente</dt>
                    <dd class="col-sm-7 fs-5 fw-bold text-primary">₡@Model.SaldoPendiente.ToString("N2")</dd>
                </dl>
                
                @if (Model.SaldoPendiente > 0)
                {
                    <div class="d-grid gap-2 mt-4">
                        <a asp-action="RegistrarPago" asp-route-id="@Model.CuentaPorPagarId" class="btn btn-success text-white">
                            <i class="fas fa-money-bill-wave me-1"></i> Registrar Pago o Anticipo
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Columna Pagos y Transacciones -->
    <div class="col-md-7 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">Transacciones e Historial Pagos</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Fecha</th>
                                <th>Transacción</th>
                                <th>Monto</th>
                                <th>Estado</th>
                                <th class="text-end pe-4">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (pagos == null || !pagos.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        No hay pagos registrados para esta cuenta.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var p in pagos)
                                {
                                    <tr>
                                        <td class="ps-4">@p.FechaPago.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (p.TipoTransaccion == "ANTICIPO")
                                            {
                                                <span class="badge bg-info text-dark">ANTICIPO</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">PAGO</span>
                                            }
                                            <div class="small text-muted mt-1">@p.MetodoPago</div>
                                        </td>
                                        <td class="fw-bold text-success">₡@p.Monto.ToString("N2")</td>
                                        <td>
                                            @if (p.Estado == "COMPLETADO")
                                            {
                                                <span class="text-success"><i class="fas fa-check-circle"></i> Completado</span>
                                            }
                                            else
                                            {
                                                <span class="text-warning text-dark"><i class="fas fa-calendar-alt"></i> Programado</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            @if (p.Estado == "PROGRAMADO")
                                            {
                                                <form asp-action="CompletarPagoProgramado" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@p.PagoProveedorId" />
                                                    <input type="hidden" name="idCuenta" value="@Model.CuentaPorPagarId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Marcar como Pagado hoy">
                                                        <i class="fas fa-check"></i> Efectuar
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
