@model IEnumerable<Abstracciones.Modelos.ReporteVentaDto>

@{
    ViewData["Title"] = "Reportes";
    var filtro = ViewBag.Filtro as Abstracciones.Modelos.ReporteVentasFiltroDto
                 ?? new Abstracciones.Modelos.ReporteVentasFiltroDto();

    var clientes = ViewBag.Clientes as List<Abstracciones.Modelos.ClienteDto> ?? new();
    var productos = ViewBag.Productos as List<Abstracciones.Modelos.ProductoDto> ?? new();

    var clientesJson = System.Text.Json.JsonSerializer.Serialize(
        clientes.Select(c => new { id = c.ClienteId, nombre = c.NombreCompleto }));
    var productosJson = System.Text.Json.JsonSerializer.Serialize(
        productos.Select(p => new { id = p.ProductoId, nombre = p.Nombre }));

    var clienteActual = clientes.FirstOrDefault(c => c.ClienteId == filtro.ClienteId);
    var productoActual = productos.FirstOrDefault(p => p.ProductoId == filtro.ProductoId);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Reportes de Ventas</h2>
        <small class="text-muted">Consulta ventas por fecha, cliente, producto y estado.</small>
    </div>

    <div>
        <a asp-action="ExportarExcel"
           asp-route-Desde="@filtro.Desde?.ToString("yyyy-MM-dd")"
           asp-route-Hasta="@filtro.Hasta?.ToString("yyyy-MM-dd")"
           asp-route-ClienteId="@filtro.ClienteId"
           asp-route-ProductoId="@filtro.ProductoId"
           asp-route-Estado="@filtro.Estado"
           class="btn btn-success">
            Exportar Excel
        </a>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label">Desde</label>
                    <input type="date"
                           class="form-control"
                           name="Desde"
                           value="@(filtro.Desde?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Hasta</label>
                    <input type="date"
                           class="form-control"
                           name="Hasta"
                           value="@(filtro.Hasta?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Cliente <small class="text-muted">(opcional)</small></label>
                    <div class="tachi-search-wrap" data-items='@Html.Raw(clientesJson)'>
                        <input type="text"
                               class="form-control tachi-search-input"
                               placeholder="Buscar cliente..."
                               value="@(clienteActual?.NombreCompleto ?? "")"
                               autocomplete="off">

                        <div class="tachi-search-dropdown"></div>

                        <input type="hidden"
                               name="ClienteId"
                               class="tachi-search-hidden"
                               value="@filtro.ClienteId">
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Producto <small class="text-muted">(opcional)</small></label>
                    <div class="tachi-search-wrap" data-items='@Html.Raw(productosJson)'>
                        <input type="text"
                               class="form-control tachi-search-input"
                               placeholder="Buscar producto..."
                               value="@(productoActual?.Nombre ?? "")"
                               autocomplete="off">

                        <div class="tachi-search-dropdown"></div>

                        <input type="hidden"
                               name="ProductoId"
                               class="tachi-search-hidden"
                               value="@filtro.ProductoId">
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Estado</label>
                    <select class="form-select" name="Estado">
                        <option value="">-- Todos --</option>
                        <option value="CREADA" selected="@(filtro.Estado == "CREADA")">CREADA</option>
                        <option value="ENTREGADA" selected="@(filtro.Estado == "ENTREGADA")">ENTREGADA</option>
                        <option value="CANCELADA" selected="@(filtro.Estado == "CANCELADA")">CANCELADA</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filtrar</button>
                </div>

                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Pedido</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio Unitario</th>
                    <th>Total Línea</th>
                    <th>Estado</th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No hay datos para mostrar.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.NumeroPedido</td>
                            <td>@item.FechaPedido.ToString("dd/MM/yyyy")</td>
                            <td>@item.ClienteNombre</td>
                            <td>@item.ProductoNombre</td>
                            <td>@item.Cantidad</td>
                            <td>&#8353; @item.PrecioUnitario.ToString("N2")</td>
                            <td>&#8353; @item.TotalLinea.ToString("N2")</td>
                            <td>
                                @if (item.Estado == "CREADA")
                                {
                                    <span class="badge bg-warning text-dark">CREADA</span>
                                }
                                else if (item.Estado == "ENTREGADA")
                                {
                                    <span class="badge bg-success">ENTREGADA</span>
                                }
                                else if (item.Estado == "CANCELADA")
                                {
                                    <span class="badge bg-danger">CANCELADA</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Estado</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if ((ViewBag.TotalPaginas ?? 0) > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">

            <li class="page-item @(ViewBag.PaginaActual <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.PaginaActual - 1)"
                   asp-route-Desde="@(filtro.Desde?.ToString("yyyy-MM-dd"))"
                   asp-route-Hasta="@(filtro.Hasta?.ToString("yyyy-MM-dd"))"
                   asp-route-ClienteId="@filtro.ClienteId"
                   asp-route-ProductoId="@filtro.ProductoId"
                   asp-route-Estado="@filtro.Estado">
                    Anterior
                </a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-Desde="@(filtro.Desde?.ToString("yyyy-MM-dd"))"
                       asp-route-Hasta="@(filtro.Hasta?.ToString("yyyy-MM-dd"))"
                       asp-route-ClienteId="@filtro.ClienteId"
                       asp-route-ProductoId="@filtro.ProductoId"
                       asp-route-Estado="@filtro.Estado">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(ViewBag.PaginaActual >= ViewBag.TotalPaginas ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.PaginaActual + 1)"
                   asp-route-Desde="@(filtro.Desde?.ToString("yyyy-MM-dd"))"
                   asp-route-Hasta="@(filtro.Hasta?.ToString("yyyy-MM-dd"))"
                   asp-route-ClienteId="@filtro.ClienteId"
                   asp-route-ProductoId="@filtro.ProductoId"
                   asp-route-Estado="@filtro.Estado">
                    Siguiente
                </a>
            </li>

        </ul>
    </nav>
}