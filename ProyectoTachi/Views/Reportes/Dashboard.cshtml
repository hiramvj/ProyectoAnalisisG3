@{
    ViewData["Title"] = "Dashboard de Métricas";
}

<!-- Cargar Librerías mediante CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="fas fa-chart-pie text-primary me-2"></i>Dashboard Gerencial</h2>
        <p class="text-muted">Métricas clave para la toma de decisiones estratégicas.</p>
    </div>
    <button id="btnExportPdf" class="btn btn-outline-danger shadow-sm">
        <i class="fas fa-file-pdf me-1"></i> Exportar a PDF
    </button>
</div>

<!-- Filtros -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body">
        <form id="frmFiltros" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold">Fecha Desde</label>
                <input type="date" id="txtDesde" name="Desde" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Fecha Hasta</label>
                <input type="date" id="txtHasta" name="Hasta" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Categoría de Producto</label>
                <select id="cbCategoria" name="CategoriaId" class="form-select" asp-items="ViewBag.Categorias">
                    <option value="">-- Todas las Categorías --</option>
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary"><i class="fas fa-filter me-1"></i> Filtrar</button>
            </div>
        </form>
    </div>
</div>

<!-- Contenedor del Reporte (para exportar a PDF) -->
<div id="pdfContainer" class="bg-white p-3 rounded">

    <!-- Tarjetas de Resumen -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card bg-primary text-white shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <i class="fas fa-coins fa-3x opacity-50"></i>
                    </div>
                    <div>
                        <h6 class="text-uppercase mb-1 opacity-75">Ingreso Total Venta</h6>
                        <h3 class="mb-0 fw-bold" id="lblTotalVentas">₡ 0.00</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-success text-white shadow-sm border-0 h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <i class="fas fa-shopping-cart fa-3x opacity-50"></i>
                    </div>
                    <div>
                        <h6 class="text-uppercase mb-1 opacity-75">Cantidad de Pedidos</h6>
                        <h3 class="mb-0 fw-bold" id="lblCantidadPedidos">0</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficos -->
    <div class="row g-4">
        <!-- Tendencia de Ventas (Líneas) -->
        <div class="col-md-12">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-secondary"><i class="fas fa-chart-line me-2"></i>Tendencia de Ventas (Mensual)</h5>
                </div>
                <div class="card-body">
                    <canvas id="chartTendencia" height="80"></canvas>
                </div>
            </div>
        </div>

        <!-- Ventas por Categoría (Anillo) -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-secondary"><i class="fas fa-chart-pie me-2"></i>Ventas por Categoría</h5>
                </div>
                <div class="card-body d-flex justify-content-center">
                    <div style="width: 100%; max-width: 350px;">
                        <canvas id="chartCategoria"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Productos (Barras) -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 text-secondary"><i class="fas fa-chart-bar me-2"></i>Top 5 Productos Vendidos</h5>
                </div>
                <div class="card-body">
                    <canvas id="chartTopProductos"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let chartTendenciaInst, chartCategoriaInst, chartTopProdInst;

        document.addEventListener('DOMContentLoaded', () => {
            // Cargar datos por defecto
            cargarMetricas();

            // Evento filtro
            document.getElementById('frmFiltros').addEventListener('submit', function(e) {
                e.preventDefault();
                cargarMetricas();
            });

            // Evento Exportar PDF
            document.getElementById('btnExportPdf').addEventListener('click', function() {
                const element = document.getElementById('pdfContainer');
                const opt = {
                    margin:       0.5,
                    filename:     'Dashboard_Metricas.pdf',
                    image:        { type: 'jpeg', quality: 0.98 },
                    html2canvas:  { scale: 2 },
                    jsPDF:        { unit: 'in', format: 'letter', orientation: 'landscape' }
                };
                html2pdf().set(opt).from(element).save();
            });
        });

        async function cargarMetricas() {
            const desde = document.getElementById('txtDesde').value;
            const hasta = document.getElementById('txtHasta').value;
            const categoriaId = document.getElementById('cbCategoria').value;

            let queryParams = new URLSearchParams();
            if (desde) queryParams.append('Desde', desde);
            if (hasta) queryParams.append('Hasta', hasta);
            if (categoriaId) queryParams.append('CategoriaId', categoriaId);

            try {
                const response = await fetch(`/Reportes/GetMetricas?${queryParams.toString()}`);
                if (!response.ok) throw new Error('Error al cargar datos');
                
                const data = await response.json();
                actualizarDashboard(data);
            } catch (error) {
                console.error(error);
                alert("Ocurrió un error obteniendo las métricas.");
            }
        }

        function formatterCost(val) {
            return '₡ ' + val.toLocaleString('es-CR', { minimumFractionDigits: 2 });
        }

        function actualizarDashboard(data) {
            // 1. Tarjetas Superiores
            document.getElementById('lblTotalVentas').textContent = formatterCost(data.totalVentas);
            document.getElementById('lblCantidadPedidos').textContent = data.cantidadPedidos;

            // 2. Gráfico Tendencia (Líneas)
            const lblsTendencia = data.ventasPorMes.map(v => v.mes);
            const valsTendencia = data.ventasPorMes.map(v => v.total);
            if (chartTendenciaInst) chartTendenciaInst.destroy();
            chartTendenciaInst = new Chart(document.getElementById('chartTendencia'), {
                type: 'line',
                data: {
                    labels: lblsTendencia,
                    datasets: [{
                        label: 'Ingresos Totales (₡)',
                        data: valsTendencia,
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true } }
                }
            });

            // 3. Gráfico Categorías (Anillo)
            const lblsCat = data.ventasPorCategoria.map(v => v.categoria);
            const valsCat = data.ventasPorCategoria.map(v => v.total);
            if (chartCategoriaInst) chartCategoriaInst.destroy();
            chartCategoriaInst = new Chart(document.getElementById('chartCategoria'), {
                type: 'doughnut',
                data: {
                    labels: lblsCat,
                    datasets: [{
                        data: valsCat,
                        backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6f42c1', '#fd7e14']
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { position: 'bottom' } }
                }
            });

            // 4. Gráfico Top Productos (Barras)
            const lblsProd = data.topProductos.map(v => v.producto);
            // Mostramos la cantidad vendida
            const valsProd = data.topProductos.map(v => v.cantidadVendida);
            if (chartTopProdInst) chartTopProdInst.destroy();
            chartTopProdInst = new Chart(document.getElementById('chartTopProductos'), {
                type: 'bar',
                data: {
                    labels: lblsProd,
                    datasets: [{
                        label: 'Unidades Vendidas',
                        data: valsProd,
                        backgroundColor: '#198754'
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true } }
                }
            });
        }
    </script>
}
