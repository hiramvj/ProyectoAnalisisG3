@model Abstracciones.Modelos.PedidoVentaDetalleDto
@{
    ViewData["Title"] = "Detalle Pedido";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Pedido #@Model.NumeroPedido</h2>
        <small class="text-muted">@Model.FechaPedido.ToString("dd/MM/yyyy") • @Model.ClienteNombre</small>
    </div>

    <div>
        <a asp-action="ImprimirFactura" asp-route-id="@Model.PedidoVentaId" class="btn btn-danger">
            Imprimir PDF
        </a>
        <a asp-action="Editar" asp-route-id="@Model.PedidoVentaId" class="btn btn-warning">
            Editar
        </a>
        <a asp-action="Historial" class="btn btn-outline-secondary">
            Volver
        </a>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="row g-2">
            <div class="col-md-3">
                <strong>Estado:</strong>
                @if (Model.Estado == "CREADA")
                {
                    <span class="badge bg-warning text-dark ms-1">CREADA</span>
                }
                else if (Model.Estado == "ENTREGADA")
                {
                    <span class="badge bg-success ms-1">ENTREGADA</span>
                }
                else if (Model.Estado == "CANCELADA")
                {
                    <span class="badge bg-danger ms-1">CANCELADA</span>
                }
                else
                {
                    <span class="badge bg-secondary ms-1">@Model.Estado</span>
                }
            </div>

            <div class="col-md-3">
                <strong>Método pago:</strong> @Model.MetodoPagoNombre
            </div>

            <div class="col-md-6">
                <strong>Observaciones:</strong> @Model.Observaciones
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="text-end" style="width:110px;">Cant.</th>
                    <th class="text-end" style="width:140px;">Precio</th>
                    <th class="text-end" style="width:140px;">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Lineas)
                {
                    <tr>
                        <td>@l.ProductoNombre</td>
                        <td class="text-end">@l.Cantidad</td>
                        <td class="text-end">₡ @l.PrecioUnitario.ToString("N2")</td>
                        <td class="text-end fw-bold">₡ @l.TotalLinea.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body text-end">
        <div class="mb-1"><strong>Subtotal:</strong> ₡ @Model.Subtotal.ToString("N2")</div>
        <div class="mb-1"><strong>IVA (13%):</strong> ₡ @Model.IVA.ToString("N2")</div>
        <div class="fw-bold fs-4"><strong>Total:</strong> ₡ @Model.Total.ToString("N2")</div>
    </div>
</div>