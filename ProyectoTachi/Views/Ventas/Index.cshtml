@model Abstracciones.Modelos.PedidoVentaCrearDto
@{
    ViewData["Title"] = "Ventas / Pedidos";
    var productos = ViewBag.Productos as List<Abstracciones.Modelos.ProductoDto> ?? new();
    var clientes  = ViewBag.Clientes  as List<Abstracciones.Modelos.ClienteDto>  ?? new();
    var productosJson = System.Text.Json.JsonSerializer.Serialize(
        productos.Select(p => new { id = p.ProductoId, nombre = p.Nombre, extra = "₡" + p.Precio.ToString("N0"), precio = p.Precio }));
    var clientesJson  = System.Text.Json.JsonSerializer.Serialize(
        clientes.Select(c => new { id = c.ClienteId, nombre = c.NombreCompleto }));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Ventas / Pedidos</h2>
        <small class="text-muted">Registro de venta y creación de pedidos para facturar.</small>
    </div>
</div>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Registro de Venta / Pedido</h5>

                <form asp-action="CrearPedido" method="post" id="frmPedido">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-2">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Cliente</label>
                            <div class="tachi-search-wrap" data-items='@Html.Raw(clientesJson)'>
                                <input type="text" class="form-control tachi-search-input" placeholder="Buscar cliente por nombre..." autocomplete="off" required>
                                <div class="tachi-search-dropdown"></div>
                                <input type="hidden" name="ClienteId" class="tachi-search-hidden" required>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Fecha</label>
                            <input class="form-control" value="@DateTime.Now.ToString("dd/MM/yyyy")" disabled />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Método de Pago</label>
                            <select class="form-select" asp-for="MetodoPagoId" asp-items="ViewBag.MetodosPago" required>
                                <option value="">-- Seleccione --</option>
                            </select>
                            <span asp-validation-for="MetodoPagoId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Observaciones</label>
                        <input class="form-control" asp-for="Observaciones" placeholder="Ej: Entregar en la tarde..." />
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h6 class="fw-bold mb-0">Detalle</h6>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="btnAgregarLinea">
                            <i class="fa-solid fa-plus me-1"></i> Agregar producto
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped mb-0" id="tblLineas">
                            <thead>
                                <tr>
                                    <th style="min-width: 320px;">Producto</th>
                                    <th style="width:140px;">Cant.</th>
                                    <th style="width:160px;" class="text-end">Precio</th>
                                    <th style="width:170px;" class="text-end">Total</th>
                                    <th style="width:60px;" class="text-center"></th>
                                </tr>
                            </thead>
                            <tbody id="tbodyLineas">
                                <tr>
                                    <td>
                                        <div class="tachi-search-wrap" data-items='@Html.Raw(productosJson)'>
                                            <input type="text" class="form-control tachi-search-input" placeholder="Buscar producto..." autocomplete="off">
                                            <div class="tachi-search-dropdown"></div>
                                            <input type="hidden" class="tachi-search-hidden producto-hidden" name="Lineas[0].ProductoId" data-precio="0">
                                        </div>
                                    </td>
                                    <td>
                                        <input class="form-control cantidad-input" type="number" name="Lineas[0].Cantidad" value="1" min="1" />
                                    </td>
                                    <td class="text-end">
                                        <span class="precio-span">₡ 0.00</span>
                                    </td>
                                    <td class="text-end">
                                        <span class="total-span fw-semibold">₡ 0.00</span>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-link text-danger btn-sm btnQuitar" title="Quitar">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-4 d-flex justify-content-start">
                        <button class="btn btn-primary" type="submit">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Guardar Pedido
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Resumen</h6>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Subtotal:</span>
                    <span id="lblSubtotal">&#8353; 0.00</span>
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">IVA (13%):</span>
                    <span id="lblIva">&#8353; 0.00</span>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold fs-5">Total:</span>
                    <span class="fw-bold fs-4 text-primary" id="lblTotal">&#8353; 0.00</span>
                </div>

                <div class="mt-3 small text-muted">
                    El resumen se calcula en pantalla. El cálculo real se hace al facturar.
                </div>
            </div>
        </div>

        <div class="card shadow-sm mt-3">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Facturar Pedido Guardado</h6>
                <p class="text-muted small mb-3">Tras guardar el pedido, aparecerá en el <strong>Historial de Ventas</strong>. Desde ahí podes facturarlo directamente.</p>
                <a asp-controller="Ventas" asp-action="Historial" class="btn btn-outline-secondary w-100">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i> Ver Historial
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // --- Productos JSON available for dynamic rows ---
        var productosData = @Html.Raw(productosJson);

        function fmt(n) {
            try { return new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC' }).format(n); }
            catch { return '&#8353; ' + (n || 0).toFixed(2); }
        }

        function getPrecioFromHidden(hiddenEl) {
            var id = parseInt(hiddenEl.value);
            if (!id) return 0;
            var p = productosData.find(function(x) { return x.id === id; });
            return p ? (p.precio || 0) : 0;
        }

        function recalcular() {
            var subtotal = 0;
            document.querySelectorAll('#tbodyLineas tr').forEach(function(tr) {
                var hidden = tr.querySelector('.producto-hidden');
                var qty    = tr.querySelector('.cantidad-input');
                var precioSpan = tr.querySelector('.precio-span');
                var totalSpan  = tr.querySelector('.total-span');
                var precio  = hidden ? getPrecioFromHidden(hidden) : 0;
                var cantidad = parseInt(qty ? qty.value : '0') || 0;
                var totalLinea = (precio > 0 && cantidad > 0) ? (precio * cantidad) : 0;
                if (precioSpan) precioSpan.textContent = fmt(precio);
                if (totalSpan)  totalSpan.textContent  = fmt(totalLinea);
                subtotal += totalLinea;
            });
            var iva   = subtotal * 0.13;
            var total = subtotal + iva;
            document.getElementById('lblSubtotal').textContent = fmt(subtotal);
            document.getElementById('lblIva').textContent      = fmt(iva);
            document.getElementById('lblTotal').textContent    = fmt(total);
        }

        function reindexarNames() {
            document.querySelectorAll('#tbodyLineas tr').forEach(function(tr, i) {
                var h = tr.querySelector('.producto-hidden');
                var q = tr.querySelector('.cantidad-input');
                if (h) h.setAttribute('name', 'Lineas[' + i + '].ProductoId');
                if (q) q.setAttribute('name', 'Lineas[' + i + '].Cantidad');
            });
        }

        function buildProductoSearchHTML(idx) {
            var items = JSON.stringify(productosData).replace(/'/g, "&#39;");
            return '<div class="tachi-search-wrap" data-items=\'' + items + '\'>' +
                   '<input type="text" class="form-control tachi-search-input" placeholder="Buscar producto..." autocomplete="off">' +
                   '<div class="tachi-search-dropdown"></div>' +
                   '<input type="hidden" class="tachi-search-hidden producto-hidden" name="Lineas[' + idx + '].ProductoId" data-precio="0">' +
                   '</div>';
        }

        document.getElementById('btnAgregarLinea').addEventListener('click', function() {
            var tbody = document.getElementById('tbodyLineas');
            var idx   = tbody.querySelectorAll('tr').length;
            var row   = document.createElement('tr');
            row.innerHTML =
                '<td>' + buildProductoSearchHTML(idx) + '</td>' +
                '<td><input class="form-control cantidad-input" type="number" name="Lineas[' + idx + '].Cantidad" value="1" min="1" /></td>' +
                '<td class="text-end"><span class="precio-span">&#8353; 0.00</span></td>' +
                '<td class="text-end"><span class="total-span fw-semibold">&#8353; 0.00</span></td>' +
                '<td class="text-center"><button type="button" class="btn btn-link text-danger btn-sm btnQuitar"><i class="fa-solid fa-xmark"></i></button></td>';
            tbody.appendChild(row);
            tachiInitAll();
            recalcular();
        });

        // Recalculate when hidden product ID changes (after autocomplete selection)
        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('producto-hidden') || e.target.classList.contains('cantidad-input')) {
                recalcular();
            }
        });

        document.addEventListener('click', function(e) {
            var btn = e.target.closest('.btnQuitar');
            if (!btn) return;
            var tbody = document.getElementById('tbodyLineas');
            var rows  = tbody.querySelectorAll('tr');
            if (rows.length <= 1) {
                var tr = rows[0];
                var h = tr.querySelector('.producto-hidden');
                var inp = tr.querySelector('.tachi-search-input');
                if (h) h.value = '';
                if (inp) inp.value = '';
                tr.querySelector('.cantidad-input').value = 1;
                recalcular();
                return;
            }
            btn.closest('tr').remove();
            reindexarNames();
            recalcular();
        });

        recalcular();
    </script>
}
