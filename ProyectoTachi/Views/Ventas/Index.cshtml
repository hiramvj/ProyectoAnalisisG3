@model Abstracciones.Modelos.PedidoVentaCrearDto
@{
    ViewData["Title"] = "Ventas / Pedidos";
    var productos = ViewBag.Productos as List<Abstracciones.Modelos.ProductoDto> ?? new();
}

<div class="container-fluid">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-0">Ventas / Pedidos</h2>
            <div class="text-muted">Registro de venta y creación de pedidos para facturar.</div>
        </div>
    </div>

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success">@TempData["Ok"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3">
        <!-- IZQUIERDA: FORM PEDIDO -->
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Registro de Venta / Pedido</h5>

                    <form asp-action="CrearPedido" method="post" id="frmPedido">
                        @Html.AntiForgeryToken()

                        <div class="row g-3 mb-2">
                            <div class="col-md-6">
                                <label class="form-label">Cliente</label>
                                <select class="form-select" asp-for="ClienteId" asp-items="ViewBag.Clientes"></select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Fecha</label>
                                <input class="form-control" value="@DateTime.Now.ToString("dd/MM/yyyy")" disabled />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Observaciones</label>
                            <input class="form-control" asp-for="Observaciones" placeholder="Ej: Entregar en la tarde..." />
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h6 class="fw-bold mb-0">Detalle</h6>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnAgregarLinea">
                                <i class="fa-solid fa-plus me-1"></i> Agregar producto
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table align-middle mb-0" id="tblLineas">
                                <thead class="table-light">
                                    <tr>
                                        <th style="min-width: 320px;">Producto</th>
                                        <th style="width:140px;">Cant.</th>
                                        <th style="width:160px;" class="text-end">Precio</th>
                                        <th style="width:170px;" class="text-end">Total</th>
                                        <th style="width:60px;" class="text-center"></th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyLineas">
                                    <!-- 1 línea por defecto -->
                                    <tr>
                                        <td>
                                            <select class="form-select producto-select" name="Lineas[0].ProductoId">
                                                <option value="0">-- Seleccionar --</option>
                                                @foreach (var p in productos)
                                                {
                                                    <option value="@p.ProductoId" data-precio="@p.Precio">@p.Nombre</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input class="form-control cantidad-input" type="number" name="Lineas[0].Cantidad" value="1" min="1" />
                                        </td>
                                        <td class="text-end">
                                            <span class="precio-span">₡ 0.00</span>
                                        </td>
                                        <td class="text-end">
                                            <span class="total-span fw-semibold">₡ 0.00</span>
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-link text-danger btn-sm btnQuitar" title="Quitar">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-4 d-flex justify-content-start">
                            <button class="btn btn-primary" type="submit">
                                <i class="fa-solid fa-floppy-disk me-1"></i> Guardar Pedido
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- DERECHA: RESUMEN -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">Resumen</h6>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal:</span>
                        <span id="lblSubtotal">₡ 0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">IVA (13%):</span>
                        <span id="lblIva">₡ 0.00</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-5">Total:</span>
                        <span class="fw-bold fs-4 text-primary" id="lblTotal">₡ 0.00</span>
                    </div>

                    <div class="mt-3 small text-muted">
                        El resumen se calcula en pantalla. El cálculo real se hace al facturar.
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <form asp-action="Facturar" method="post">
                        @Html.AntiForgeryToken()
                        <label class="form-label">PedidoVentaId</label>
                        <input class="form-control mb-3" type="number" name="pedidoVentaId" placeholder="Ej: 3" required />

                        <button class="btn btn-success w-100" type="submit">
                            <i class="fa-solid fa-receipt me-1"></i> Facturar e Imprimir
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Formato moneda CRC simple
        function fmt(n) {
            try {
                return new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC' }).format(n);
            } catch {
                return '₡ ' + (n || 0).toFixed(2);
            }
        }

        function recalcular() {
            let subtotal = 0;

            document.querySelectorAll('#tbodyLineas tr').forEach(tr => {
                const sel = tr.querySelector('.producto-select');
                const qty = tr.querySelector('.cantidad-input');
                const precioSpan = tr.querySelector('.precio-span');
                const totalSpan = tr.querySelector('.total-span');

                const opt = sel.options[sel.selectedIndex];
                const precio = parseFloat(opt?.dataset?.precio || '0');
                const cantidad = parseInt(qty.value || '0');

                const totalLinea = (precio > 0 && cantidad > 0) ? (precio * cantidad) : 0;

                precioSpan.textContent = fmt(precio);
                totalSpan.textContent = fmt(totalLinea);

                subtotal += totalLinea;
            });

            const iva = subtotal * 0.13;
            const total = subtotal + iva;

            document.getElementById('lblSubtotal').textContent = fmt(subtotal);
            document.getElementById('lblIva').textContent = fmt(iva);
            document.getElementById('lblTotal').textContent = fmt(total);
        }

        function reindexarNames() {
            const rows = document.querySelectorAll('#tbodyLineas tr');
            rows.forEach((tr, i) => {
                tr.querySelector('.producto-select').setAttribute('name', `Lineas[${i}].ProductoId`);
                tr.querySelector('.cantidad-input').setAttribute('name', `Lineas[${i}].Cantidad`);
            });
        }

        document.getElementById('btnAgregarLinea').addEventListener('click', () => {
            const tbody = document.getElementById('tbodyLineas');
            const idx = tbody.querySelectorAll('tr').length;

            const row = document.createElement('tr');
            row.innerHTML = `
                <td>
                    <select class="form-select producto-select" name="Lineas[${idx}].ProductoId">
                        <option value="0">-- Seleccionar --</option>
                        ${`@Html.Raw(string.Join("", productos.Select(p => $"<option value='{p.ProductoId}' data-precio='{p.Precio}'>{System.Net.WebUtility.HtmlEncode(p.Nombre)}</option>")))`}
                    </select>
                </td>
                <td>
                    <input class="form-control cantidad-input" type="number" name="Lineas[${idx}].Cantidad" value="1" min="1" />
                </td>
                <td class="text-end"><span class="precio-span">₡ 0.00</span></td>
                <td class="text-end"><span class="total-span fw-semibold">₡ 0.00</span></td>
                <td class="text-center">
                    <button type="button" class="btn btn-link text-danger btn-sm btnQuitar" title="Quitar">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(row);
            recalcular();
        });

        document.addEventListener('change', (e) => {
            if (e.target.classList.contains('producto-select') || e.target.classList.contains('cantidad-input')) {
                recalcular();
            }
        });

        document.addEventListener('click', (e) => {
            const btn = e.target.closest('.btnQuitar');
            if (!btn) return;

            const tbody = document.getElementById('tbodyLineas');
            const rows = tbody.querySelectorAll('tr');

            // Dejar mínimo 1 línea
            if (rows.length <= 1) {
                // limpiar selección/cantidad
                const tr = rows[0];
                tr.querySelector('.producto-select').value = "0";
                tr.querySelector('.cantidad-input').value = 1;
                recalcular();
                return;
            }

            btn.closest('tr').remove();
            reindexarNames();
            recalcular();
        });

        // Inicial
        recalcular();
    </script>
}