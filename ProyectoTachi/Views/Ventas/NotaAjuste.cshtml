@model Abstracciones.Modelos.NotaContableDto

@{
    ViewData["Title"] = "Nuevo Ajuste Contable";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="fa-solid fa-file-pen me-2"></i>Generar Nota de Ajuste</h5>
            <span class="badge bg-secondary">Referencia Factura: #@Model.FacturaId</span>
        </div>
        <div class="card-body">
            <form id="formNotaAjuste" asp-action="NotaAjuste" method="post">
                @Html.AntiForgeryToken() <input type="hidden" asp-for="FacturaId" />
                <input type="hidden" asp-for="FacturaId" />
                <input type="hidden" asp-for="MontoMaximo" id="MontoMaximo" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Naturaleza del Ajuste</label>
                        <select asp-for="Tipo" class="form-select border-primary">
                            <option value="Credito">Nota de Crédito (Resta saldo / Devolución)</option>
                            <option value="Debito">Nota de Débito (Suma saldo / Cargo extra)</option>
                        </select>
                        <div class="form-text">Las Notas de Crédito disminuyen la cuenta por cobrar del cliente.</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Monto a Ajustar</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">₡</span>
                            <input asp-for="Monto" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <small class="text-muted">Monto máximo sugerido: @Model.MontoMaximo.ToString("C", new System.Globalization.CultureInfo("es-CR"))</small>
                        <span asp-validation-for="Monto" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Justificación Técnica (Detalle)</label>
                    <textarea asp-for="Detalle" class="form-control" rows="3" placeholder="Describa el motivo del ajuste (ej: producto defectuoso, error en flete...)"></textarea>
                    <span asp-validation-for="Detalle" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a asp-action="Historial" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Volver
                    </a>
                    <button type="submit" class="btn btn-primary shadow-sm">
                        <i class="fa-solid fa-check"></i> Aplicar Nota Contable
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.getElementById('formNotaAjuste').addEventListener('submit', function (e) {
            e.preventDefault(); // IMPORTANTE: Esto evita que salte la pantalla negra con el JSON

            const formulario = this;
            const formData = new FormData(formulario);

            // 1. Mostrar loading
            Swal.fire({
                title: 'Procesando ajuste...',
                text: 'Espere un momento',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // 2. Enviar por AJAX (fetch)
            fetch(formulario.action || window.location.href, {
                method: 'POST',
                body: formData,
                headers: {
                    // Esto ayuda a ASP.NET a entender que es una petición AJAX
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // 3. ¡El modal de éxito que querías!
                    Swal.fire({
                        icon: 'success',
                        title: '¡Ajuste Aplicado!',
                        text: data.message,
                        confirmButtonColor: '#0d6efd'
                    }).then(() => {
                        // Redirigir al historial después de cerrar el modal
                        window.location.href = '@Url.Action("Historial")';
                    });
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            })
            .catch(error => {
                Swal.fire('Error', 'No se pudo conectar con el servidor', 'error');
            });
        });
    </script>
}