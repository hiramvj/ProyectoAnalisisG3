@model Abstracciones.Modelos.PedidoVentaEditarDto
@{
    ViewData["Title"] = "Editar Pedido";
}

<div class="tachi-formbox">
    <h2>Editar Pedido</h2>

    <form asp-action="Editar" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PedidoVentaId" />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Estado</label>
                <select asp-for="Estado" class="form-select">
                    <option value="CREADA">CREADA</option>
                    <option value="ENTREGADA">ENTREGADA</option>
                    <option value="CANCELADA">CANCELADA</option>
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label">Método de Pago</label>
                <select asp-for="MetodoPagoId" class="form-select" asp-items="ViewBag.MetodosPago">
                    <option value="">-- Sin método --</option>
                </select>
            </div>

            <div class="col-md-12">
                <label class="form-label">Observaciones</label>
                <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2 justify-content-end">
            <button class="btn btn-primary btn-pill px-4">Guardar</button>
            <a asp-action="Historial" class="btn btn-outline-secondary btn-pill px-4">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}