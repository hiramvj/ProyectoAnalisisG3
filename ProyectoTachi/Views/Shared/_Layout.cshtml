<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProyectoTachi</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoTachi.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ventas.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="tachi-bg">

    <!-- SHELL -->
    <div class="tachi-shell">

        <!-- SIDEBAR -->
        <aside class="tachi-sidebar">
            <div class="tachi-brand">
                <div class="tachi-brand-title">
                    <span class="tachi-brand-accent">TACHI</span>
                    <i class="fa-solid fa-truck-fast ms-2"></i>
                </div>
                <div class="tachi-brand-sub">DISTRIBUIDORA</div>
            </div>

            <nav class="tachi-menu">
                <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Dashboard</span>
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Productos" ? "active" : "")"
                       asp-controller="Productos" asp-action="Index">
                        <i class="fa-solid fa-boxes-stacked"></i>
                        <span>Inventario</span>
                    </a>

                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clientes" ? "active" : "")"
                       asp-controller="Clientes" asp-action="Index">
                        <i class="fa-solid fa-users"></i>
                        <span>Clientes</span>
                    </a>
                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ventas" ? "active" : "")"
                       asp-controller="Ventas" asp-action="Index">
                        <i class="fa-solid fa-receipt"></i>
                        <span>Ventas</span>
                    </a>
                    <a class="tachi-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Historial" ? "active" : "")"
                       asp-controller="Ventas" asp-action="Historial">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <span>Historial Ventas</span>
                    </a>
                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transportistas" ? "active" : "")"
                       asp-controller="Transportistas" asp-action="Index">
                        <i class="fa-solid fa-id-card"></i>
                        <span>Transportistas</span>
                    </a>

                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rutas" ? "active" : "")"
                       asp-controller="Rutas" asp-action="Index">
                        <i class="fa-solid fa-route"></i>
                        <span>Rutas</span>
                    </a>
                    <a class="tachi-link"
                       asp-controller="Productos" asp-action="Inactivos">
                        <i class="fa-solid fa-box-archive"></i>
                        <span>Productos Inactivos</span>
                    </a>
                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Proveedores" ? "active" : "")"
                       asp-controller="Proveedores" asp-action="Index">
                        <i class="fa-solid fa-truck"></i>
                        <span>Proveedores</span>
                    </a>
                    <a class="tachi-link"
                       asp-controller="Empleados"
                       asp-action="Index">
                        <i class="fa-solid fa-user-tie"></i>
                        <span>Empleados</span>
                    </a>
                    
                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Compras" ? "active" : "")"
                       asp-controller="Compras" asp-action="Index">
                        <i class="fa-solid fa-cart-shopping"></i>
                        <span>Órdenes de Compra</span>
                    </a>
                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reportes" ? "active" : "")"
                       asp-controller="Reportes" asp-action="Index">
                        <i class="fa-solid fa-chart-column"></i>
                        <span>Reportes</span>
                    </a>
                }

                <div class="tachi-divider"></div>

                <a class="tachi-link" asp-area="" asp-controller="Home" asp-action="Privacy">
                    <i class="fa-solid fa-shield-halved"></i>
                    <span>Seguridad/Privacidad</span>
                </a>
            </nav>
        </aside>

        <!-- MAIN -->
        <div class="tachi-main">

            <!-- TOPBAR -->
            <header class="tachi-topbar">
                <div class="tachi-topbar-left">
                    <h6 class="m-0 tachi-page-title">@ViewData["Title"]</h6>
                </div>

                <div class="tachi-topbar-right">
                    <button class="tachi-icon-btn" type="button" title="Notificaciones">
                        <i class="fa-regular fa-bell"></i>
                    </button>

                    <!-- Login / Logout (Identity) -->
                    <partial name="_LoginPartial" />
                </div>
            </header>

            <!-- CONTENT -->
            <main class="tachi-content">
                @RenderBody()
            </main>

            <!-- FOOTER -->
            <footer class="tachi-footer">
                <span>&copy; 2026 - ProyectoTachi</span>
            </footer>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>