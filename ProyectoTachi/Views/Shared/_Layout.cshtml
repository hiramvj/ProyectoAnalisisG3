<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProyectoTachi</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoTachi.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ventas.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body class="tachi-bg">

    <!-- SHELL -->
    <div class="tachi-shell">

        <!-- SIDEBAR -->
        <aside class="tachi-sidebar">
            <div class="tachi-brand">
                <div class="tachi-brand-title">
                    <span class="tachi-brand-accent">TACHI</span>
                    <i class="fa-solid fa-truck-fast ms-2"></i>
                </div>
                <div class="tachi-brand-sub">DISTRIBUIDORA</div>
            </div>

            <nav class="tachi-menu">
                <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Dashboard</span>
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Productos" ? "active" : "")"
                       asp-controller="Productos" asp-action="Index">
                        <i class="fa-solid fa-boxes-stacked"></i>
                        <span>Inventario</span>
                    </a>

                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clientes" ? "active" : "")"
                       asp-controller="Clientes" asp-action="Index">
                        <i class="fa-solid fa-users"></i>
                        <span>Clientes</span>
                    </a>
                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ventas" ? "active" : "")"
                       asp-controller="Ventas" asp-action="Index">
                        <i class="fa-solid fa-receipt"></i>
                        <span>Ventas</span>
                    </a>
                    <a class="tachi-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Historial" ? "active" : "")"
                       asp-controller="Ventas" asp-action="Historial">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <span>Historial Ventas</span>
                    </a>
                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Devoluciones" ? "active" : "")"
                       asp-controller="Devoluciones" asp-action="Index">
                        <i class="fa-solid fa-rotate-left"></i>
                        <span>Devoluciones</span>
                    </a>
                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transportistas" ? "active" : "")"
                       asp-controller="Transportistas" asp-action="Index">
                        <i class="fa-solid fa-id-card"></i>
                        <span>Transportistas</span>
                    </a>

                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rutas" ? "active" : "")"
                       asp-controller="Rutas" asp-action="Index">
                        <i class="fa-solid fa-route"></i>
                        <span>Rutas</span>
                    </a>
                    <a class="tachi-link"
                       asp-controller="Productos" asp-action="Inactivos">
                        <i class="fa-solid fa-box-archive"></i>
                        <span>Productos Inactivos</span>
                    </a>
                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Proveedores" ? "active" : "")"
                       asp-controller="Proveedores" asp-action="Index">
                        <i class="fa-solid fa-truck"></i>
                        <span>Proveedores</span>
                    </a>
                    <a class="tachi-link"
                       asp-controller="Empleados"
                       asp-action="Index">
                        <i class="fa-solid fa-user-tie"></i>
                        <span>Empleados</span>
                    </a>
                    
                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Compras" ? "active" : "")"
                       asp-controller="Compras" asp-action="Index">
                        <i class="fa-solid fa-cart-shopping"></i>
                        <span>Órdenes de Compra</span>
                    </a>
                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CuentasPorPagar" ? "active" : "")"
                       asp-controller="CuentasPorPagar" asp-action="Index">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                        <span>Cuentas por Pagar</span>
                    </a>
                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reportes" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                       asp-controller="Reportes" asp-action="Index">
                        <i class="fa-solid fa-table-list"></i>
                        <span>Reportes Tabulares</span>
                    </a>
                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reportes" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                       asp-controller="Reportes" asp-action="Dashboard">
                        <i class="fa-solid fa-chart-pie"></i>
                        <span>Dashboard Métricas</span>
                    </a>

                    <a class="tachi-link @(ViewContext.RouteData.Values["action"]?.ToString() == "InformeFinanciero" ? "active" : "")"
                       asp-controller="Home" asp-action="InformeFinanciero">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                        <span>Informe Financiero</span>
                    </a>
                }

                <div class="tachi-divider"></div>
                @if (User.IsInRole("Admin"))
                {
                    <a class="tachi-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Security" ? "active" : "")"
                       asp-controller="Security" asp-action="Intentos">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>Intentos Fallidos</span>
                    </a>
                }

            </nav>
        </aside>

        <!-- MAIN -->
        <div class="tachi-main">

            <!-- TOPBAR -->
            <header class="tachi-topbar">
                <div class="tachi-topbar-left">
                    <h6 class="m-0 tachi-page-title">@ViewData["Title"]</h6>
                </div>

                <div class="tachi-topbar-right">
                    <button class="tachi-icon-btn" type="button" title="Notificaciones">
                        <i class="fa-regular fa-bell"></i>
                    </button>

                    <!-- Login / Logout (Identity) -->
                    <partial name="_LoginPartial" />
                </div>
            </header>

            <!-- CONTENT -->
            <main class="tachi-content">
                @RenderBody()
            </main>

            <!-- FOOTER -->
            <footer class="tachi-footer">
                <span>&copy; 2026 - ProyectoTachi</span>
            </footer>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- ===== AUTOCOMPLETE ENGINE (global) ===== -->
    <script>
        function tachiInitAutocomplete(wrap) {
            var items;
            try { items = JSON.parse(wrap.dataset.items || '[]'); } catch { items = []; }

            var input    = wrap.querySelector('.tachi-search-input');
            var dropdown = wrap.querySelector('.tachi-search-dropdown');
            var hidden   = wrap.querySelector('.tachi-search-hidden');
            var badge    = wrap.querySelector('.tachi-search-selected');
            if (!input || !dropdown || !hidden) return;

            var highlighted = -1;

            function showDropdown(results) {
                dropdown.innerHTML = '';
                highlighted = -1;
                if (!results.length) { dropdown.style.display = 'none'; wrap.classList.remove('open'); return; }
                results.forEach(function(item, idx) {
                    var div = document.createElement('div');
                    div.className = 'tachi-search-item';
                    div.textContent = item.nombre;
                    if (item.extra) div.textContent += ' — ' + item.extra;
                    div.addEventListener('mousedown', function(e) { e.preventDefault(); selectItem(item); });
                    dropdown.appendChild(div);
                });
                dropdown.style.display = 'block';
                wrap.classList.add('open');
            }

            function selectItem(item) {
                input.value = item.nombre;
                hidden.value = item.id;
                dropdown.style.display = 'none';
                wrap.classList.remove('open');
                if (badge) {
                    badge.querySelector('.badge-label').textContent = item.nombre;
                    badge.style.display = 'flex';
                }
                // dispatch change so precio/costo can recalculate
                hidden.dispatchEvent(new Event('change', { bubbles: true }));
            }

            if (badge) {
                var clearBtn = badge.querySelector('.clear-btn');
                if (clearBtn) clearBtn.addEventListener('click', function() {
                    input.value = '';
                    hidden.value = '';
                    badge.style.display = 'none';
                    input.focus();
                });
                if (hidden.value) badge.style.display = 'flex';
            }

            input.addEventListener('input', function() {
                var q = input.value.toLowerCase().trim();
                if (!q) { dropdown.style.display = 'none'; wrap.classList.remove('open'); hidden.value = ''; return; }
                var found = items.filter(function(i) { return i.nombre.toLowerCase().includes(q); }).slice(0, 14);
                showDropdown(found);
            });

            input.addEventListener('keydown', function(e) {
                var divs = dropdown.querySelectorAll('.tachi-search-item');
                if (!divs.length) return;
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    highlighted = Math.min(highlighted + 1, divs.length - 1);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    highlighted = Math.max(highlighted - 1, 0);
                } else if (e.key === 'Enter' && highlighted >= 0) {
                    e.preventDefault();
                    divs[highlighted].dispatchEvent(new Event('mousedown'));
                    return;
                } else if (e.key === 'Escape') {
                    dropdown.style.display = 'none'; wrap.classList.remove('open'); return;
                }
                divs.forEach(function(d, i) { d.classList.toggle('highlighted', i === highlighted); });
                if (highlighted >= 0) divs[highlighted].scrollIntoView({ block: 'nearest' });
            });

            input.addEventListener('focus', function() {
                if (input.value.trim()) input.dispatchEvent(new Event('input'));
            });

            document.addEventListener('click', function(e) {
                if (!wrap.contains(e.target)) { dropdown.style.display = 'none'; wrap.classList.remove('open'); }
            });
        }

        function tachiInitAll() {
            document.querySelectorAll('.tachi-search-wrap:not([data-init])').forEach(function(w) {
                w.dataset.init = '1';
                tachiInitAutocomplete(w);
            });
        }

        document.addEventListener('DOMContentLoaded', tachiInitAll);
        // also expose for dynamic rows
        window.tachiInitAll = tachiInitAll;
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>