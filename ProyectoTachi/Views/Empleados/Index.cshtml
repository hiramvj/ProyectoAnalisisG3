@model List<Abstracciones.Modelos.EmpleadoDto>

@{
    ViewData["Title"] = "Empleados";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Empleados</h2>
        <small class="text-muted">Administra tus empleados activos.</small>
    </div>

    <div>
        <a asp-action="Inactivos" class="btn btn-outline-secondary">Inactivos</a>
        <a asp-action="Create" class="btn btn-success">+ Agregar Empleado</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre Completo</th>
                    <th>Identificación</th>
                    <th>Puesto</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th style="width:250px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EmpleadoId</td>
                        <td>@item.NombreCompleto</td>
                        <td>@item.Identificacion</td>
                        <td>@item.Puesto</td>
                        <td>@item.Telefono</td>
                        <td>@(item.Activo ? "Activo" : "Inactivo")</td>
                        <td>
                            <a asp-action="Asistencias" asp-route-id="@item.EmpleadoId" class="btn btn-sm btn-info">Asistencias</a>
                            <a asp-action="Edit" asp-route-id="@item.EmpleadoId" class="btn btn-sm btn-warning">Editar</a>

                            <form asp-action="Desactivar" method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.EmpleadoId" />
                                <button type="submit" class="btn btn-sm btn-danger">Desactivar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>