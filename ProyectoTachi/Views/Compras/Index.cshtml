@model Abstracciones.Modelos.OrdenCompraCrearDto
@{
    ViewData["Title"] = "Compras / Órdenes";
    var productos = ViewBag.Productos as List<Abstracciones.Modelos.ProductoDto> ?? new();
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">
        @TempData["Ok"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Compras / Órdenes</h2>
        <small class="text-muted">Creación de órdenes de compra a proveedores.</small>
    </div>
</div>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3">
    <!-- IZQUIERDA -->
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Registro de Orden de Compra</h5>

                <form asp-action="CrearOrden" method="post" id="frmOrden">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-2">
                        <div class="col-md-6">
                            <label class="form-label">Proveedor</label>
                            <select class="form-select" asp-for="ProveedorId" asp-items="ViewBag.Proveedores"></select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Fecha Emisión</label>
                            <input class="form-control" value="@DateTime.Now.ToString("dd/MM/yyyy")" disabled />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Observaciones</label>
                        <input class="form-control" asp-for="Observaciones" placeholder="Ej: Entregar en la mañana..." />
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold mb-0">Detalle</h6>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="btnAgregarLinea">
                            <i class="fa-solid fa-plus me-1"></i> Agregar producto
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped mb-0" id="tblLineas">
                            <thead>
                                <tr>
                                    <th style="min-width: 320px;">Producto</th>
                                    <th style="width:140px;">Cant.</th>
                                    <th style="width:160px;" class="text-end">Costo</th>
                                    <th style="width:170px;" class="text-end">Total</th>
                                    <th style="width:60px;" class="text-center"></th>
                                </tr>
                            </thead>
                            <tbody id="tbodyLineas">
                                <tr>
                                    <td>
                                        <select class="form-select producto-select" name="Lineas[0].ProductoId">
                                            <option value="0">-- Seleccionar --</option>
                                            @foreach (var p in productos)
                                            {
                                                <option value="@p.ProductoId" data-costo="@p.Costo">@p.Nombre</option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input class="form-control cantidad-input" type="number" name="Lineas[0].Cantidad" value="1" min="1" />
                                    </td>
                                    <td>
                                        <input class="form-control costo-input text-end" type="number" step="0.01" name="Lineas[0].CostoUnitario" value="0" min="0" />
                                    </td>
                                    <td class="text-end">
                                        <span class="total-span fw-semibold">₡ 0.00</span>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-link text-danger btn-sm btnQuitar">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-4">
                        <button class="btn btn-primary" type="submit">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Guardar Orden
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- DERECHA -->
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Resumen</h6>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Subtotal:</span>
                    <span id="lblSubtotal">₡ 0.00</span>
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">IVA (13%):</span>
                    <span id="lblIva">₡ 0.00</span>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold fs-5">Total:</span>
                    <span class="fw-bold fs-4 text-primary" id="lblTotal">₡ 0.00</span>
                </div>
            </div>
        </div>
    </div>
</div>