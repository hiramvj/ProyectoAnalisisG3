@model List<Abstracciones.Modelos.ProveedorDto>
@{
    ViewData["Title"] = "Proveedores Inactivos";
}

<div class="container-fluid">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-0">Proveedores Inactivos</h2>
            <p class="text-muted mb-0">Proveedores que ya no están disponibles para selección.</p>
        </div>

        <a class="btn btn-outline-secondary" asp-action="Index">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;">ID</th>
                            <th>Nombre Legal</th>
                            <th style="width: 170px;">Cédula Jurídica</th>
                            <th style="width: 220px;">Correo</th>
                            <th style="width: 150px;">Teléfono</th>
                            <th style="width: 220px;">Dirección</th>
                            <th style="width: 120px;">Estado</th>
                            <th class="text-end" style="width: 190px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || Model.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    No hay proveedores inactivos.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var p in Model)
                            {
                                <tr>
                                    <td>@p.ProveedorId</td>
                                    <td class="fw-semibold">@p.NombreLegal</td>
                                    <td>@p.CedulaJuridica</td>
                                    <td>@(string.IsNullOrWhiteSpace(p.Correo) ? "—" : p.Correo)</td>
                                    <td>@(string.IsNullOrWhiteSpace(p.Telefono) ? "—" : p.Telefono)</td>
                                    <td>@(string.IsNullOrWhiteSpace(p.Direccion) ? "—" : p.Direccion)</td>
                                    <td>
                                        <span class="badge bg-secondary">Inactivo</span>
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="Activar" asp-route-id="@p.ProveedorId"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                Activar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
