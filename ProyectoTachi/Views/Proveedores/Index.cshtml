@model List<Abstracciones.Modelos.ProveedorDto>
@{
    ViewData["Title"] = "Proveedores";
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">
        @TempData["Ok"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Proveedores</h2>
        <small class="text-muted">Administra tus proveedores activos.</small>
    </div>

    <div>
        <a class="btn btn-outline-secondary" asp-action="Inactivos">
            Inactivos
        </a>

        <a class="btn btn-success" asp-action="Create">
            + Agregar Proveedor
        </a>
    </div>
</div>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th style="width:80px;">ID</th>
                    <th>Nombre Legal</th>
                    <th style="width:170px;">Cédula Jurídica</th>
                    <th style="width:220px;">Correo</th>
                    <th style="width:150px;">Teléfono</th>
                    <th style="width:220px;">Dirección</th>
                    <th style="width:120px;">Estado</th>
                    <th style="width:190px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No hay proveedores activos.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.ProveedorId</td>
                            <td>@p.NombreLegal</td>
                            <td>@p.CedulaJuridica</td>
                            <td>@(string.IsNullOrWhiteSpace(p.Correo) ? "—" : p.Correo)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.Telefono) ? "—" : p.Telefono)</td>
                            <td>@(string.IsNullOrWhiteSpace(p.Direccion) ? "—" : p.Direccion)</td>
                            <td>
                                <span class="badge bg-success">Activo</span>
                            </td>
                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@p.ProveedorId"
                                   class="btn btn-sm btn-warning">
                                    Editar
                                </a>

                                <form asp-action="Desactivar"
                                      asp-route-id="@p.ProveedorId"
                                      method="post"
                                      style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        Desactivar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>