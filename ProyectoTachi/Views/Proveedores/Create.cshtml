@model Abstracciones.Modelos.ProveedorDto
@{
    ViewData["Title"] = "Nuevo Proveedor";
}

<div class="container-fluid">

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-0">Nuevo Proveedor</h2>
            <p class="text-muted mb-0">Completa la información del proveedor.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nombre Legal *</label>
                        <input class="form-control" asp-for="NombreLegal" />
                        <span class="text-danger small" asp-validation-for="NombreLegal"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Cédula Jurídica *</label>
                        <input class="form-control" asp-for="CedulaJuridica" />
                        <span class="text-danger small" asp-validation-for="CedulaJuridica"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Correo</label>
                        <input class="form-control" asp-for="Correo" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Teléfono</label>
                        <input class="form-control" asp-for="Telefono" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Dirección</label>
                        <input class="form-control" asp-for="Direccion" />
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Guardar
                    </button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}