@model Abstracciones.Modelos.ProductoDto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="tachi-page">
    <div class="tachi-card">
        <div class="tachi-card-header">
            <div>
                <h2 class="tachi-title">Editar producto</h2>
                <p class="tachi-subtitle">Actualiza los datos del inventario</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>

        <hr class="tachi-sep" />

        <form asp-action="Edit" method="post" class="tachi-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductoId" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="SKU" class="form-label">Código (SKU)</label>
                    <input asp-for="SKU" class="form-control" />
                    <span asp-validation-for="SKU" class="text-danger"></span>
                </div>

                <div class="col-md-8">
                    <label asp-for="Nombre" class="form-label">Producto</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CategoriaProductoId" class="form-label">Categoría</label>
                    <select asp-for="CategoriaProductoId" class="form-select" asp-items="ViewBag.Categorias">
                        <option value="">-- Selecciona una categoría --</option>
                    </select>
                    <span asp-validation-for="CategoriaProductoId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="UnidadMedidaId" class="form-label">Unidad de medida (ID)</label>
                    <input asp-for="UnidadMedidaId" class="form-control" type="number" min="1" />
                    <span asp-validation-for="UnidadMedidaId" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Stock" class="form-label">Stock</label>
                    <input asp-for="Stock" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Stock" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="StockMinimo" class="form-label">Stock mínimo</label>
                    <input asp-for="StockMinimo" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="StockMinimo" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Costo" class="form-label">Costo</label>
                    <input asp-for="Costo" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Costo" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Precio" class="form-label">Precio</label>
                    <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>
            </div>

            <div class="tachi-actions">
                <button type="submit" class="btn btn-primary btn-lg px-4">Guardar cambios</button>
                <a asp-action="Index" class="btn btn-light btn-lg px-4">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}