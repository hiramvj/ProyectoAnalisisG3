@model List<Abstracciones.Modelos.ProductoDto>

@{
    ViewData["Title"] = "Productos";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success">
        @TempData["Ok"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Productos</h2>
        <small class="text-muted">Administra tu inventario y filtra rápidamente.</small>
    </div>

    <div>
        <a asp-action="Create" class="btn btn-success">
            + Agregar Producto
        </a>
    </div>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a asp-action="Index" class="nav-link active">
            Activos
        </a>
    </li>
    <li class="nav-item">
        <a asp-action="Inactivos" class="nav-link">
            Inactivos
        </a>
    </li>
</ul>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get">
            <div class="row g-3 align-items-end">

                <div class="col-lg-5">
                    <label class="form-label">Nombre</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               name="nombre"
                               value="@Context.Request.Query["nombre"]"
                               class="form-control"
                               placeholder="Buscar por nombre..." />
                    </div>
                </div>

                <div class="col-lg-3">
                    <label class="form-label">Precio mínimo</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">₡</span>
                        <input type="number"
                               step="0.01"
                               name="precioMin"
                               value="@Context.Request.Query["precioMin"]"
                               class="form-control"
                               placeholder="0" />
                    </div>
                </div>

                <div class="col-lg-3">
                    <label class="form-label">Precio máximo</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">₡</span>
                        <input type="number"
                               step="0.01"
                               name="precioMax"
                               value="@Context.Request.Query["precioMax"]"
                               class="form-control"
                               placeholder="0" />
                    </div>
                </div>

                <div class="col-lg-1 d-grid">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel-fill"></i>
                    </button>
                </div>

            </div>

            <div class="mt-2">
                <a asp-action="Index" class="btn btn-link p-0">
                    <i class="bi bi-x-circle me-1"></i> Limpiar filtros
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Producto</th>
                    <th>Stock</th>
                    <th>Precio Unidad</th>
                    <th>Estado</th>
                    <th style="width:200px;">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No hay productos activos.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        var bajoStock = item.Stock <= item.StockMinimo;

                        <tr>
                            <td>@item.SKU</td>
                            <td>@item.Nombre</td>

                            <td class="@(bajoStock ? "text-danger fw-bold" : "")">
                                @item.Stock
                            </td>

                            <td>₡ @item.Precio.ToString("N2")</td>

                            <td>
                                @if (bajoStock)
                                {
                                    <span class="badge bg-warning text-dark">Bajo Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Disponible</span>
                                }
                            </td>

                            <td>
                                <a asp-action="Edit"
                                   asp-route-id="@item.ProductoId"
                                   class="btn btn-sm btn-warning">
                                    Editar
                                </a>

                                <form asp-action="Desactivar"
                                      method="post"
                                      style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.ProductoId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-danger"
                                            onclick="return confirm('¿Desea desactivar este producto?')">
                                        Desactivar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if ((ViewBag.TotalPaginas ?? 0) > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">

            <li class="page-item @(ViewBag.PaginaActual <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.PaginaActual - 1)"
                   asp-route-nombre="@Context.Request.Query["nombre"]"
                   asp-route-precioMin="@Context.Request.Query["precioMin"]"
                   asp-route-precioMax="@Context.Request.Query["precioMax"]">
                    Anterior
                </a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-nombre="@Context.Request.Query["nombre"]"
                       asp-route-precioMin="@Context.Request.Query["precioMin"]"
                       asp-route-precioMax="@Context.Request.Query["precioMax"]">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(ViewBag.PaginaActual >= ViewBag.TotalPaginas ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.PaginaActual + 1)"
                   asp-route-nombre="@Context.Request.Query["nombre"]"
                   asp-route-precioMin="@Context.Request.Query["precioMin"]"
                   asp-route-precioMax="@Context.Request.Query["precioMax"]">
                    Siguiente
                </a>
            </li>

        </ul>
    </nav>
}