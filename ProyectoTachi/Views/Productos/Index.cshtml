@model List<Abstracciones.Modelos.ProductoDto>

@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Productos</h2>
        <small class="text-muted">Administra tu inventario y filtra rápidamente.</small>
    </div>

    <a asp-action="Create" class="btn btn-success">
        + Agregar Producto
    </a>
</div>

<!-- FILTROS (NO SE ELIMINAN) -->
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get">
            <div class="row g-3 align-items-end">

                <div class="col-lg-5">
                    <label class="form-label">Nombre</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               name="nombre"
                               value="@Context.Request.Query["nombre"]"
                               class="form-control"
                               placeholder="Buscar por nombre..." />
                    </div>
                </div>

                <div class="col-lg-3">
                    <label class="form-label">Precio mínimo</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">₡</span>
                        <input type="number"
                               step="0.01"
                               name="precioMin"
                               value="@Context.Request.Query["precioMin"]"
                               class="form-control"
                               placeholder="0" />
                    </div>
                </div>

                <div class="col-lg-3">
                    <label class="form-label">Precio máximo</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">₡</span>
                        <input type="number"
                               step="0.01"
                               name="precioMax"
                               value="@Context.Request.Query["precioMax"]"
                               class="form-control"
                               placeholder="0" />
                    </div>
                </div>

                <div class="col-lg-1 d-grid">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel-fill"></i>
                    </button>
                </div>

            </div>

            <div class="mt-2">
                <a asp-action="Index" class="btn btn-link p-0">
                    <i class="bi bi-x-circle me-1"></i> Limpiar filtros
                </a>
            </div>
        </form>
    </div>
</div>

<!-- TABLA -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Producto</th>
                    <th>Stock</th>
                    <th>Precio Unidad</th>
                    <th>Estado</th>
                    <th style="width:200px;">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    var bajoStock = item.Stock <= item.StockMinimo;

                    <tr>
                        <td>@item.SKU</td>
                        <td>@item.Nombre</td>

                        <td class="@(bajoStock ? "text-danger fw-bold" : "")">
                            @item.Stock
                        </td>

                        <td>₡ @item.Precio.ToString("N2")</td>

                        <td>
                            @if (bajoStock)
                            {
                                <span class="badge bg-warning text-dark">Bajo Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Disponible</span>
                            }
                        </td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@item.ProductoId"
                               class="btn btn-sm btn-warning">
                                Editar
                            </a>

                            <form asp-action="Desactivar"
                                  method="post"
                                  style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.ProductoId" />

                                <button type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('¿Desea desactivar este producto?')">
                                    Desactivar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>