@model ProyectoTachi.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold text-primary">Panel de Control</h1>
            <p class="lead text-muted">Resumen general de la ferretería.</p>
        </div>
    </div>

    <!-- Metrics Cards -->
    <div class="row g-4 mb-5">
        <!-- Total Products -->
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted text-uppercase">Total Productos</h6>
                    <div class="d-flex align-items-center justify-content-between">
                        <h2 class="card-title fw-bold mb-0">@Model.TotalProductos</h2>
                        <span class="badge bg-primary rounded-pill"><i class="bi bi-box-seam"></i></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Low Stock -->
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm border-start border-4 @(Model.ProductosBajoStock > 0 ? "border-danger" : "border-success")">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted text-uppercase">Bajo Stock</h6>
                     <div class="d-flex align-items-center justify-content-between">
                        <h2 class="card-title fw-bold mb-0 @(Model.ProductosBajoStock > 0 ? "text-danger" : "text-success")">@Model.ProductosBajoStock</h2>
                        <span class="badge bg-danger rounded-pill"><i class="bi bi-exclamation-triangle"></i></span>
                    </div>
                    @if(Model.ProductosBajoStock > 0)
                    {
                        <small class="text-danger mt-2 d-block">Requiere atención</small>
                    }
                    else
                    {
                        <small class="text-success mt-2 d-block">Inventario saludable</small>
                    }
                </div>
            </div>
        </div>

        <!-- Total Clients -->
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted text-uppercase">Clientes Registrados</h6>
                    <div class="d-flex align-items-center justify-content-between">
                        <h2 class="card-title fw-bold mb-0">@Model.TotalClientes</h2>
                        <span class="badge bg-info rounded-pill text-dark"><i class="bi bi-people"></i></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Clients -->
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted text-uppercase">Clientes Activos</h6>
                    <div class="d-flex align-items-center justify-content-between">
                        <h2 class="card-title fw-bold mb-0">@Model.ClientesActivos</h2>
                        <span class="badge bg-success rounded-pill"><i class="bi bi-person-check"></i></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-12">
            <h4 class="mb-3 text-secondary">Accesos Rápidos</h4>
        </div>
        <div class="col-md-6 col-lg-4 mb-3">
            <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-primary btn-lg w-100 py-4 text-start shadow-sm hover-shadow transition">
                <div class="d-flex align-items-center">
                    <div class="fs-1 me-3"><i class="bi bi-tools"></i></div>
                    <div>
                        <div class="fw-bold">Gestión de Inventario</div>
                        <small class="text-muted">Agregar, editar y ver productos</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4 mb-3">
            <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline-success btn-lg w-100 py-4 text-start shadow-sm hover-shadow transition">
                <div class="d-flex align-items-center">
                    <div class="fs-1 me-3"><i class="bi bi-person-badge"></i></div>
                    <div>
                        <div class="fw-bold">Gestión de Clientes</div>
                        <small class="text-muted">Administrar cartera de clientes</small>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
        transition: all 0.3s ease;
    }
    .transition {
        transition: all 0.3s ease;
    }
</style>
