@model ProyectoTachi.Models.DashboardViewModel
@{
    ViewData["Title"] = "Inicio";
}

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    var esAdmin = User.IsInRole("Admin");
    var esVentas = User.IsInRole("Ventas");
    var esOperaciones = User.IsInRole("Operaciones");
    var esGerencia = User.IsInRole("Gerencia");
    var nombrePanel = esAdmin ? "Administración" : esVentas ? "Ventas e Inventario" : esOperaciones ? "Operaciones" : "Gerencia";

    <div class="container-fluid py-4">
        <div class="row mb-4">
            <div class="col-12">
                <h1 class="display-5 fw-bold text-primary">Panel de Control</h1>
                <p class="lead text-muted">Panel de @nombrePanel.</p>
            </div>
        </div>

        <div class="row g-4 mb-5">
            @if (esAdmin || esVentas)
            {
                <div class="col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><h6 class="text-muted text-uppercase">Ventas de hoy</h6><h2 class="fw-bold text-success">₡@Model.VentasHoy.ToString("N2")</h2><small>Facturación acumulada del día</small></div></div></div>
                <div class="col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><h6 class="text-muted text-uppercase">Pedidos de hoy</h6><h2 class="fw-bold">@Model.PedidosHoy</h2><small>@Model.FacturasHoy facturados</small></div></div></div>
                <div class="col-md-4"><div class="card h-100 border-0 shadow-sm border-start border-4 @(Model.ProductosBajoStock > 0 ? "border-danger" : "border-success")"><div class="card-body"><h6 class="text-muted text-uppercase">Productos bajo stock</h6><h2 class="fw-bold @(Model.ProductosBajoStock > 0 ? "text-danger" : "text-success")">@Model.ProductosBajoStock</h2><small>De @Model.TotalProductos productos registrados</small></div></div></div>
            }

            @if (esAdmin || esOperaciones)
            {
                <div class="col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><h6 class="text-muted text-uppercase">Órdenes pendientes</h6><h2 class="fw-bold text-warning">@Model.OrdenesPendientes</h2><small>Compras por completar</small></div></div></div>
                <div class="col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><h6 class="text-muted text-uppercase">Rutas activas</h6><h2 class="fw-bold text-primary">@Model.RutasActivas</h2><small>Entregas en planificación o curso</small></div></div></div>
                <div class="col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><h6 class="text-muted text-uppercase">Proveedores activos</h6><h2 class="fw-bold">@Model.ProveedoresActivos</h2><small>Disponibles para abastecimiento</small></div></div></div>
            }

            @if (esAdmin || esGerencia)
            {
                <div class="col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><h6 class="text-muted text-uppercase">Ventas del mes</h6><h2 class="fw-bold text-success">₡@Model.VentasMes.ToString("N2")</h2><small>Ingresos facturados este mes</small></div></div></div>
                <div class="col-md-4"><div class="card h-100 border-0 shadow-sm"><div class="card-body"><h6 class="text-muted text-uppercase">Saldo por pagar</h6><h2 class="fw-bold text-danger">₡@Model.SaldoPorPagar.ToString("N2")</h2><small>Compromisos con proveedores</small></div></div></div>
                <div class="col-md-4"><div class="card h-100 border-0 shadow-sm border-start border-4 @(Model.CuentasVencidas > 0 ? "border-danger" : "border-success")"><div class="card-body"><h6 class="text-muted text-uppercase">Cuentas vencidas</h6><h2 class="fw-bold @(Model.CuentasVencidas > 0 ? "text-danger" : "text-success")">@Model.CuentasVencidas</h2><small>Requieren seguimiento financiero</small></div></div></div>
            }
        </div>

        <!-- Quick Actions -->
        <div class="row">
            <div class="col-12">
                <h4 class="mb-3 text-secondary">Accesos Rápidos</h4>
            </div>
            @if (esAdmin || esVentas)
            {
            <div class="col-md-6 col-lg-4 mb-3">
                <a asp-controller="Productos" asp-action="Index" class="btn btn-outline-primary btn-lg w-100 py-4 text-start shadow-sm hover-shadow transition">
                    <div class="d-flex align-items-center">
                        <div class="fs-1 me-3"><i class="bi bi-tools"></i></div>
                        <div>
                            <div class="fw-bold">Gestión de Inventario</div>
                            <small class="text-muted">Agregar, editar y ver productos</small>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-lg-4 mb-3">
                <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline-success btn-lg w-100 py-4 text-start shadow-sm hover-shadow transition">
                    <div class="d-flex align-items-center">
                        <div class="fs-1 me-3"><i class="bi bi-person-badge"></i></div>
                        <div>
                            <div class="fw-bold">Gestión de Clientes</div>
                            <small class="text-muted">Administrar cartera de clientes</small>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-lg-4 mb-3">
                <a asp-controller="Ventas" asp-action="Index" class="btn btn-outline-info btn-lg w-100 py-4 text-start shadow-sm hover-shadow transition">
                    <div class="d-flex align-items-center">
                        <div class="fs-1 me-3"><i class="bi bi-receipt"></i></div>
                        <div>
                            <div class="fw-bold">Registrar Venta</div>
                            <small class="text-muted">Crear pedidos y facturas</small>
                        </div>
                    </div>
                </a>
            </div>
            }

            @if (esAdmin || esOperaciones)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <a asp-controller="Compras" asp-action="Index" class="btn btn-outline-warning btn-lg w-100 py-4 text-start shadow-sm hover-shadow transition">
                        <div class="d-flex align-items-center"><div class="fs-1 me-3"><i class="bi bi-cart"></i></div><div><div class="fw-bold">Órdenes de Compra</div><small class="text-muted">Gestionar abastecimiento</small></div></div>
                    </a>
                </div>
                <div class="col-md-6 col-lg-4 mb-3">
                    <a asp-controller="Rutas" asp-action="Index" class="btn btn-outline-primary btn-lg w-100 py-4 text-start shadow-sm hover-shadow transition">
                        <div class="d-flex align-items-center"><div class="fs-1 me-3"><i class="bi bi-truck"></i></div><div><div class="fw-bold">Rutas y Entregas</div><small class="text-muted">Coordinar la distribución</small></div></div>
                    </a>
                </div>
                <div class="col-md-6 col-lg-4 mb-3">
                    <a asp-controller="Proveedores" asp-action="Index" class="btn btn-outline-secondary btn-lg w-100 py-4 text-start shadow-sm hover-shadow transition">
                        <div class="d-flex align-items-center"><div class="fs-1 me-3"><i class="bi bi-building"></i></div><div><div class="fw-bold">Proveedores</div><small class="text-muted">Administrar proveedores</small></div></div>
                    </a>
                </div>
            }

            @if (esAdmin || esGerencia)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <a asp-controller="Reportes" asp-action="Dashboard" class="btn btn-outline-success btn-lg w-100 py-4 text-start shadow-sm hover-shadow transition">
                        <div class="d-flex align-items-center"><div class="fs-1 me-3"><i class="bi bi-graph-up"></i></div><div><div class="fw-bold">Métricas Gerenciales</div><small class="text-muted">Consultar indicadores</small></div></div>
                    </a>
                </div>
                <div class="col-md-6 col-lg-4 mb-3">
                    <a asp-controller="CuentasPorPagar" asp-action="Index" class="btn btn-outline-danger btn-lg w-100 py-4 text-start shadow-sm hover-shadow transition">
                        <div class="d-flex align-items-center"><div class="fs-1 me-3"><i class="bi bi-cash-stack"></i></div><div><div class="fw-bold">Cuentas por Pagar</div><small class="text-muted">Control financiero</small></div></div>
                    </a>
                </div>
            }
        </div>
    </div>
}
else
{
    <!-- Landing Page for Unauthenticated Users -->
    <div class="container py-5">
        <div class="row align-items-center mb-5">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold text-primary mb-3">Bienvenido a TACHI Distribuidora</h1>
                <p class="lead text-muted mb-4">La solución integral para gestionar su ferretería con eficiencia, control y tecnología de vanguardia. Todo lo que necesita en un solo lugar.</p>
                <div class="d-flex gap-3">
                    <a class="btn btn-primary btn-lg px-4 rounded-pill shadow-sm" asp-area="Identity" asp-page="/Account/Login">
                        <i class="fa-solid fa-right-to-bracket me-2"></i> Iniciar Sesión
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center d-none d-lg-block">
                <img src="/images/hero-illustration.svg" alt="Tachi ERP" class="img-fluid rounded-4 shadow" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&q=80&w=800';" style="max-height: 400px; object-fit: cover;">
            </div>
        </div>

        <div class="row text-center mt-5">
            <div class="col-12 mb-4">
                <h2 class="fw-bold text-secondary">Beneficios de nuestro sistema</h2>
            </div>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm text-center p-4 hover-shadow transition">
                    <div class="card-body">
                        <div class="text-primary mb-3">
                            <i class="fa-solid fa-boxes-stacked fa-3x"></i>
                        </div>
                        <h5 class="card-title fw-bold">Inventario Inteligente</h5>
                        <p class="card-text text-muted small">Control en tiempo real de productos, alertas de stock mínimo y gestión por categorías.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm text-center p-4 hover-shadow transition">
                    <div class="card-body">
                        <div class="text-success mb-3">
                            <i class="fa-solid fa-users fa-3x"></i>
                        </div>
                        <h5 class="card-title fw-bold">Cartera de Clientes</h5>
                        <p class="card-text text-muted small">Administre la información de sus clientes, historiales de ventas y datos de contacto.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm text-center p-4 hover-shadow transition">
                    <div class="card-body">
                        <div class="text-warning mb-3">
                            <i class="fa-solid fa-truck-fast fa-3x"></i>
                        </div>
                        <h5 class="card-title fw-bold">Relación con Proveedores</h5>
                        <p class="card-text text-muted small">Generación de órdenes de compra, control de entrada de mercancía y gestión de pagos.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm text-center p-4 hover-shadow transition">
                    <div class="card-body">
                        <div class="text-info mb-3">
                            <i class="fa-solid fa-file-invoice-dollar fa-3x"></i>
                        </div>
                        <h5 class="card-title fw-bold">Facturación Rápida</h5>
                        <p class="card-text text-muted small">Cree pedidos de venta y genere facturen segundos, afectando el inventario automáticamente.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
        transition: all 0.3s ease;
    }
    .transition {
        transition: all 0.3s ease;
    }
</style>
