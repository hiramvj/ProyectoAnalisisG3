@model Abstracciones.Modelos.DevolucionResultadoDto
@{
    ViewData["Title"] = "Detalle de Devolución";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Devolución #@Model.DevolucionVentaId</h2>
        <small class="text-muted">Factura #@Model.NumeroFactura</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Volver
    </a>
</div>

@if (TempData["Ok"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fa-solid fa-circle-check me-1"></i> @TempData["Ok"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-3">
    <!-- Info Devolución -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fa-solid fa-rotate-left me-2"></i>Datos de la Devolución</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <td class="text-muted" style="width:160px;">Fecha:</td>
                        <td class="fw-bold">@Model.FechaDevolucion.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Tipo:</td>
                        <td>
                            @if (Model.Tipo == "TOTAL")
                            {
                                <span class="badge bg-danger">DEVOLUCIÓN TOTAL</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">DEVOLUCIÓN PARCIAL</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Estado:</td>
                        <td><span class="badge bg-success">@Model.Estado</span></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Motivo:</td>
                        <td>@Model.Motivo</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Monto Total:</td>
                        <td class="fw-bold fs-5 text-danger">₡@Model.MontoTotal.ToString("N2")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- Nota de Crédito -->
    <div class="col-md-6">
        <div class="card shadow-sm h-100 border-info">
            <div class="card-header bg-info bg-opacity-10">
                <h5 class="mb-0"><i class="fa-solid fa-file-invoice-dollar me-2"></i>Nota de Crédito NC-@Model.NumeroNotaCredito</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <td class="text-muted" style="width:160px;">Número:</td>
                        <td class="fw-bold">NC-@Model.NumeroNotaCredito</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Subtotal:</td>
                        <td>₡@Model.NCSubtotal.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Impuesto (13%):</td>
                        <td>₡@Model.NCImpuesto.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Total:</td>
                        <td class="fw-bold fs-5 text-primary">₡@Model.NCTotal.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Estado:</td>
                        <td><span class="badge bg-info text-dark">EMITIDA</span></td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Detalle de productos devueltos -->
<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="fa-solid fa-boxes-stacked me-2"></i>Productos Devueltos</h5>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th style="width:150px;">Cant. Devuelta</th>
                    <th style="width:150px;">Precio Unit.</th>
                    <th style="width:150px;">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var linea in Model.Lineas)
                {
                    <tr>
                        <td>@linea.ProductoNombre</td>
                        <td class="fw-bold">@linea.CantidadDevuelta</td>
                        <td>₡@linea.PrecioUnitario.ToString("N2")</td>
                        <td class="fw-bold">₡@((linea.CantidadDevuelta * linea.PrecioUnitario).ToString("N2"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
