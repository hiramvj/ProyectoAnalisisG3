@{
    ViewData["Title"] = "Nueva Devolución";
    var lineas = ViewBag.Lineas as List<Abstracciones.Modelos.DevolucionLineaDto>;
    int? facturaSeleccionada = ViewBag.FacturaIdSeleccionada as int?;
    string motivo = ViewBag.Motivo as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Nueva Devolución</h2>
        <small class="text-muted">Seleccione la factura y los productos a devolver</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Volver
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fa-solid fa-circle-exclamation me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Paso 1: Seleccionar factura -->
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="fa-solid fa-file-invoice me-2"></i>Paso 1: Seleccionar Factura</h5>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Crear">
            <div class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label class="form-label">Factura</label>
                    <select name="facturaId" class="form-select" asp-items="ViewBag.Facturas">
                        <option value="">-- Seleccione una factura --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-search me-1"></i> Cargar Productos
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Paso 2: Detalle de devolución -->
@if (lineas != null && lineas.Any())
{
    <form method="post" asp-action="Crear">
        <input type="hidden" name="facturaId" value="@facturaSeleccionada" />

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fa-solid fa-rotate-left me-2"></i>Paso 2: Indicar Cantidades a Devolver</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th style="width:150px;">Cant. Facturada</th>
                            <th style="width:150px;">Precio Unit.</th>
                            <th style="width:180px;">Cant. a Devolver</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < lineas.Count; i++)
                        {
                            <tr>
                                <td>
                                    @lineas[i].ProductoNombre
                                    <input type="hidden" name="lineas[@i].ProductoId" value="@lineas[i].ProductoId" />
                                    <input type="hidden" name="lineas[@i].PrecioUnitario" value="@lineas[i].PrecioUnitario" />
                                    <input type="hidden" name="lineas[@i].CantidadFacturada" value="@lineas[i].CantidadFacturada" />
                                </td>
                                <td class="fw-bold">@lineas[i].CantidadFacturada</td>
                                <td>₡@lineas[i].PrecioUnitario.ToString("N2")</td>
                                <td>
                                    <input type="number"
                                           name="lineas[@i].CantidadDevuelta"
                                           class="form-control"
                                           min="0"
                                           max="@lineas[i].CantidadFacturada"
                                           step="1"
                                           value="0" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fa-solid fa-comment me-2"></i>Paso 3: Motivo de Devolución</h5>
            </div>
            <div class="card-body">
                <textarea name="motivo" class="form-control" rows="3"
                          placeholder="Escriba el motivo de la devolución..." required>@motivo</textarea>
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <div class="text-muted small align-self-center">
                <i class="fa-solid fa-info-circle me-1"></i>
                Se generará automáticamente una nota de crédito y se repondrá el inventario.
            </div>
            <button type="submit" class="btn btn-danger btn-lg">
                <i class="fa-solid fa-rotate-left me-2"></i>Procesar Devolución
            </button>
        </div>
    </form>
}
