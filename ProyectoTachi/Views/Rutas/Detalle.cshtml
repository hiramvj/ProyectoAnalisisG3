@model List<Abstracciones.Modelos.RutaEntregaDetalleVistaDto>
@using Abstracciones.Modelos
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var ruta = ViewBag.Ruta as RutaEntregaDto;
    var nueva = ViewBag.NuevaParada as RutaEntregaDetalleDto;
    var pedidos = ViewBag.Pedidos as List<SelectListItem> ?? new List<SelectListItem>();

    ViewData["Title"] = "Detalle de Ruta";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Detalle de Ruta</h2>
        <small class="text-muted">
            Código: <strong>@ruta?.CodigoRuta</strong> |
            Fecha: <strong>@ruta?.FechaProgramada?.ToString("yyyy-MM-dd")</strong> |
            Estado: <strong>@ruta?.Estado</strong>
        </small>
    </div>

    <div>
        <a asp-action="Index" class="btn btn-secondary">
            ← Volver
        </a>
    </div>
</div>

<hr />

<div class="row">
    <div class="col-md-5">

        <div class="card shadow-sm">
            <div class="card-header">
                <strong>Agregar pedido a la ruta</strong>
            </div>

            <div class="card-body">
                <form asp-action="AgregarPedido" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="RutaId" value="@nueva?.RutaId" />

                    <div class="mb-3">
                        <label class="form-label">Pedido</label>
                        <select name="PedidoVentaId" class="form-select" required>
                            <option value="">Seleccione...</option>
                            @foreach (var p in pedidos)
                            {
                                <option value="@p.Value">@p.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Orden de parada</label>
                        <input type="number"
                               name="OrdenParada"
                               class="form-control"
                               value="@nueva?.OrdenParada"
                               required />
                    </div>

                    <input type="hidden" name="EstadoParada" value="PENDIENTE" />

                    <button type="submit" class="btn btn-success">
                        Agregar pedido
                    </button>
                </form>
            </div>
        </div>

    </div>

    <div class="col-md-7">

        <div class="card shadow-sm">
            <div class="card-header">
                <strong>Pedidos en la ruta</strong>
            </div>

            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Orden</th>
                            <th>Pedido</th>
                            <th>Estado</th>
                            <th style="width:220px;">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">
                                    No hay pedidos asignados a esta ruta.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.OrderBy(x => x.OrdenParada))
                            {
                                <tr>
                                    <td>@item.OrdenParada</td>
                                    <td>Pedido #@item.PedidoVentaId</td>
                                    <td>
                                        <span class="badge bg-info">
                                            @item.EstadoParada
                                        </span>
                                    </td>
                                    <td>
                                        <form asp-action="CambiarEstadoParada"
                                              method="post"
                                              style="display:inline">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="rutaDetalleId" value="@item.RutaDetalleId" />
                                            <input type="hidden" name="rutaId" value="@item.RutaId" />
                                            <input type="hidden" name="estadoParada" value="ENTREGADA" />

                                            <button class="btn btn-sm btn-success">
                                                Entregado
                                            </button>
                                        </form>

                                        <form asp-action="EliminarPedido"
                                              method="post"
                                              style="display:inline">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="rutaDetalleId" value="@item.RutaDetalleId" />
                                            <input type="hidden" name="rutaId" value="@item.RutaId" />

                                            <button class="btn btn-sm btn-danger">
                                                Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-3">
            <form asp-action="CambiarEstadoRuta" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="rutaId" value="@ruta?.RutaId" />

                <button name="estado"
                        value="EN_RUTA"
                        class="btn btn-primary">
                    Iniciar Ruta
                </button>

                <button name="estado"
                        value="FINALIZADA"
                        class="btn btn-dark">
                    Finalizar Ruta
                </button>

                <button name="estado"
                        value="CANCELADA"
                        class="btn btn-outline-danger">
                    Cancelar Ruta
                </button>
            </form>
        </div>

    </div>
</div>