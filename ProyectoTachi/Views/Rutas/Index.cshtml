@model List<Abstracciones.Modelos.RutaEntregaDto>

@{
    ViewData["Title"] = "Rutas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Rutas de Entrega</h2>
        <small class="text-muted">Administra las rutas programadas.</small>
    </div>

    <a asp-action="Create" class="btn btn-success">
        + Agregar Ruta
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Código</th>
                    <th>Fecha</th>
                    <th>Transportista</th>
                    <th>Estado</th>
                    <th>Observaciones</th>
                    <th style="width:220px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            No hay rutas registradas.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.RutaId</td>
                            <td>@item.CodigoRuta</td>
                            <td>@item.FechaProgramada?.ToString("yyyy-MM-dd")</td>
                            <td>@(item.NombreTransportista ?? "-")</td>
                            <td>@item.Estado</td>
                            <td>@item.Observaciones</td>
                            <td>
                                <a asp-action="Detalle" asp-route-id="@item.RutaId" class="btn btn-sm btn-primary">Detalle</a>
                                <a asp-action="Edit" asp-route-id="@item.RutaId" class="btn btn-sm btn-warning">Editar</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>