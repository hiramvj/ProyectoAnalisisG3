@model Abstracciones.Modelos.RutaEntregaDto
@{
    ViewData["Title"] = "Crear Ruta";
    var transportistas = ViewBag.Transportistas as IEnumerable<Abstracciones.Modelos.TransportistaDto> ?? Enumerable.Empty<Abstracciones.Modelos.TransportistaDto>();
    var transportistasJson = System.Text.Json.JsonSerializer.Serialize(
        transportistas.Select(t => new { id = t.TransportistaId, nombre = t.NombreCompleto }));
}

<h2 class="mb-3">Crear Ruta</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="CodigoRuta" class="form-label"></label>
                <input asp-for="CodigoRuta" class="form-control" />
                <span asp-validation-for="CodigoRuta" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaProgramada" class="form-label"></label>
                <input asp-for="FechaProgramada" type="date" class="form-control" />
                <span asp-validation-for="FechaProgramada" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Transportista</label>
                <div class="tachi-search-wrap" data-items='@Html.Raw(transportistasJson)'>
                    <input type="text" class="form-control tachi-search-input" placeholder="Buscar transportista por nombre..." autocomplete="off">
                    <div class="tachi-search-dropdown"></div>
                    <input type="hidden" asp-for="TransportistaId" class="tachi-search-hidden" required>
                </div>
                <span asp-validation-for="TransportistaId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Estado" class="form-label"></label>
                <select asp-for="Estado" class="form-select">
                    <option value="PLANIFICADA">PLANIFICADA</option>
                    <option value="EN_RUTA">EN_RUTA</option>
                    <option value="FINALIZADA">FINALIZADA</option>
                    <option value="CANCELADA">CANCELADA</option>
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Observaciones" class="form-label"></label>
                <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Observaciones" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
