@model Abstracciones.Modelos.ClienteDto

@{
    ViewData["Title"] = "Detalle del Cliente";
}

<h2>Detalle del Cliente</h2>

<div class="card shadow-sm border-0 mt-3" style="border-radius:14px;">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Nombre Completo</label>
                <div class="form-control bg-light">@Model.NombreCompleto</div>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Identificación</label>
                <div class="form-control bg-light">@Model.Identificacion</div>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Correo</label>
                <div class="form-control bg-light">@Model.Correo</div>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Teléfono</label>
                <div class="form-control bg-light">@Model.Telefono</div>
            </div>

            <div class="col-md-12">
                <label class="form-label fw-bold">Dirección</label>
                <div class="form-control bg-light">@Model.Direccion</div>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Estado</label>
                <div class="form-control bg-light">
                    @(Model.Activo ? "Activo" : "Inactivo")
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Fecha de Creación</label>
                <div class="form-control bg-light">
                    @Model.FechaCreacion.ToString("dd/MM/yyyy")
                </div>
            </div>
        </div>

        <div class="mt-4">
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
            <a asp-action="Edit" asp-route-id="@Model.ClienteId" class="btn btn-warning">Editar</a>
        </div>
    </div>
</div>