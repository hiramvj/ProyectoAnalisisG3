@model List<Abstracciones.Modelos.ClienteDto>

@{
    ViewData["Title"] = "Clientes";
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger">
        @TempData["MensajeError"]
    </div>
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">
        @TempData["MensajeExito"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Clientes</h2>
        <small class="text-muted">Administra tus clientes activos.</small>
    </div>

    <div>
        <a asp-action="Inactivos" class="btn btn-outline-secondary">Inactivos</a>
        <a asp-action="Create" class="btn btn-success">+ Agregar Cliente</a>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Buscar</label>
                <input type="text"
                       name="q"
                       value="@(ViewBag.Q ?? "")"
                       class="form-control"
                       placeholder="Cédula, nombre o correo..." />
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Filtrar</button>
            </div>

            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Identificación</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th style="width:220px;">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Identificacion</td>
                        <td>@item.NombreCompleto</td>
                        <td>@item.Correo</td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@item.ClienteId"
                               class="btn btn-sm btn-info">
                                Ver
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.ClienteId"
                               class="btn btn-sm btn-warning">
                                Editar
                            </a>

                            <form asp-action="Desactivar"
                                  method="post"
                                  style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.ClienteId" />

                                <button type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('¿Desea desactivar este cliente?')">
                                    Desactivar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if ((ViewBag.TotalPaginas ?? 0) > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">

            <li class="page-item @(ViewBag.PaginaActual <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.PaginaActual - 1)"
                   asp-route-q="@ViewBag.Q">
                    Anterior
                </a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-q="@ViewBag.Q">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(ViewBag.PaginaActual >= ViewBag.TotalPaginas ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.PaginaActual + 1)"
                   asp-route-q="@ViewBag.Q">
                    Siguiente
                </a>
            </li>

        </ul>
    </nav>
}