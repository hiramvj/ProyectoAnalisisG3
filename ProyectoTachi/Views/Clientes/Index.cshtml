@model List<Abstracciones.Modelos.ClienteDto>

@{
    ViewData["Title"] = "Clientes";
}

<h2>Clientes Activos</h2>
<div class="row g-3 align-items-stretch mb-3">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-white h-100"
             style="background: linear-gradient(135deg, #18b7e4, #11c9a5); border-radius: 14px;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold" style="font-size: 1rem;">Clientes Activos</div>
                    <div class="fw-bold" style="font-size: 2.2rem; line-height: 1;">
                        @ViewBag.TotalClientesActivos
                    </div>
                </div>

                <div class="text-white" style="opacity: .75;">
                    <i class="bi bi-person-check-fill" style="font-size: 2.6rem;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Cliente</a>
    <a asp-action="Inactivos" class="btn btn-secondary">Ver Inactivos</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Identificación</th>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Identificacion</td>
                <td>@item.NombreCompleto</td>
                <td>@item.Correo</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ClienteId" class="btn btn-sm btn-warning">Editar</a>

                    <form asp-action="Desactivar" asp-route-id="@item.ClienteId"
                          method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">
                            Desactivar
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
